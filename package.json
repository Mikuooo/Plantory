{
  "name": "plantory-workspace",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:mobile": "pnpm --filter plantory start",
    "dev:android": "pnpm --filter plantory android",
    "lint:mobile": "pnpm --filter plantory lint",
    "typecheck:mobile": "pnpm --filter plantory typecheck",
    "check:repo": "node scripts/harness/check-repo.mjs",
    "check:docs": "node scripts/harness/check-docs.mjs",
    "check:architecture": "node scripts/harness/check-architecture.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "harness:check": "pnpm check:repo && pnpm check:docs && pnpm check:architecture && pnpm lint && pnpm typecheck && pnpm test",
    "e2e:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/harness/run-maestro-android.ps1"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "~5.9.2"
  }
}
